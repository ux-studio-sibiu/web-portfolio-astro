---
import { Font, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "@/layouts/Base.astro";
import { HOME_TITLE } from "@/lib/projects";
import homeShare from "@/assets/share/home.png";
// An import in the frontmatter puts this CSS on every page that USES this
// layout, and only those. globals.scss locks the body (`overflow: hidden`, the
// shell scrolls itself), so it must not reach the lesson pages, which use Base
// directly.
import "@/styles/globals.scss";

interface Props {
  title?: string;
  description?: string;
  // The share picture; the home page's when none is given.
  image?: ImageMetadata;
}

const {
  title = HOME_TITLE,
  description = "Selected work by a frontend developer building fast, functional interfaces.",
  image = homeShare,
} = Astro.props;

// Through the same optimiser as every other picture, as a 1200px JPEG: the
// width the platforms render previews at, and the one format every preview
// fetcher is sure to read (lesson 14).
const share = await getImage({ src: image, width: 1200, format: "jpeg", quality: 82 });

// No `viewport` passed, so Base's plain one applies. The Next layout exported
// `maximum-scale=1, user-scalable=no`, which stops visitors pinch-zooming the
// page (WCAG 1.4.4, Resize Text); dropped in lesson 12. The page has no inputs
// for iOS to zoom into, which is what that setting is usually there to stop.

// Archivo sets the page, so it is preloaded — but only its LATIN file. The
// latin-ext one carries the Ț and ă in the Contact name at the foot of the
// page; it is still fetched, as the name is in the page, just without jumping
// the queue ahead of what the first screen needs (lesson 12).
//
// JetBrains Mono's latin file is preloaded too: the label and the whole blurb
// on the first screen are set in it. Left to be discovered through the CSS, it
// arrived a round trip later than Archivo, and the first screen visibly
// changed font after it had painted — which Speed Index counts as still
// loading.
---

<Base title={title} description={description} image={share.src}>
  <Fragment slot="head">
    <Font cssVariable="--font-archivo" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-jetbrains-mono" preload={[{ subset: "latin" }]} />
  </Fragment>
  <slot />
</Base>
