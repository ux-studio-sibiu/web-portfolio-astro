---
import { Font } from "astro:assets";
import Base from "@/layouts/Base.astro";
// An import in the frontmatter puts this CSS on every page that USES this
// layout, and only those. globals.scss locks the body (`overflow: hidden`, the
// shell scrolls itself), so it must not reach the lesson pages, which use Base
// directly.
import "@/styles/globals.scss";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Razvan Turcanu — Frontend Developer",
  description = "Selected work by a frontend developer building fast, functional interfaces.",
} = Astro.props;

// No `viewport` passed, so Base's plain one applies. The Next layout exported
// `maximum-scale=1, user-scalable=no`, which stops visitors pinch-zooming the
// page (WCAG 1.4.4, Resize Text); dropped in lesson 12. The page has no inputs
// for iOS to zoom into, which is what that setting is usually there to stop.

// Archivo sets the page, so it is preloaded — but only its LATIN file. The
// latin-ext one carries the Ț and ă in the Contact name at the foot of the
// page; it is still fetched, as the name is in the page, just without jumping
// the queue ahead of what the first screen needs (lesson 12). The mono is
// small copy and can arrive a moment later.
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <Font cssVariable="--font-archivo" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-jetbrains-mono" />
  </Fragment>
  <slot />
</Base>
