---
// Everything between the --- fences runs at BUILD time, in Node, once per page.
// None of it reaches the browser. The template below it is the HTML that does.
interface Props {
  title: string;
  description?: string;
  // Lesson pages are for us, not for search engines.
  noindex?: boolean;
  // The portfolio passes its own (see Portfolio.astro); everything else gets
  // the plain one.
  viewport?: string;
}

const { title, description, noindex = false, viewport = "width=device-width, initial-scale=1" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content={viewport} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/icon.jpg" type="image/jpeg" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
