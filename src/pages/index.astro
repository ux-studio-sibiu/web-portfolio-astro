---
// Placeholder until lesson 03 puts the shell here. It already sits on the
// real layout, so the fonts, tokens and global classes can be checked.
import Portfolio from "@/layouts/Portfolio.astro";
---

<Portfolio>
  <main class="nsc-placeholder">
    <p class="label">Placeholder · lesson 02</p>
    <h1 class="band-heading">Țurcanu Răzvan</h1>
    <p>The portfolio is being rebuilt in Astro, one lesson at a time.</p>
    <p class="spec-note">d3.js, three.js, map-libre, webgl</p>
    <p><a class="inline-link" href="/lessons/">Lessons</a></p>
  </main>
</Portfolio>

<style lang="scss">
  @use "@/styles/breakpoints" as *;

  .nsc-placeholder {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: var(--gutter);

    @include respond-to("tablet") {
      padding-left: calc(var(--rail) + var(--gutter));
    }
  }
</style>
