---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { blurStyle } from "@/lib/blur-placeholder";

// Every optimised picture on the index goes through here: the stand-in for
// next/image with `placeholder="blur"`.
//
// `sizes` is the same hint the Next version gave; `widths` is the list of files
// to make for it. Next made one per entry of its device and image size lists
// up to the original width; this does the same with a shorter list, plus the
// original itself, so the browser never upscales.
//
// Two formats, AVIF then WebP (lesson 12). next/image picked one per request
// from the browser's Accept header — a server decision a static site cannot
// make. A <picture> is the static answer: it lists both, and the browser takes
// the first it can decode. AVIF came out 48% smaller than WebP across these
// thumbnails; WebP stays for the browsers that cannot read AVIF.
//
// The <picture> is `display: contents`, so it generates no box: the <img>
// inside lays out exactly as it did when it stood alone, and every stylesheet
// written against the <img> (its class, its size, object-fit) still applies.
interface Props {
  src: ImageMetadata;
  sizes: string;
  class?: string;
  // Empty by default: on the index a picture is decoration on a button that
  // already says what it opens. A detail body passes real alt text.
  alt?: string;
  "aria-hidden"?: "true";
}

const { src, sizes, class: className, alt = "", "aria-hidden": ariaHidden } = Astro.props;

const CANDIDATES = [256, 384, 640, 750, 828, 1080, 1200, 1920];
const widths = [...CANDIDATES.filter((w) => w < src.width), src.width];
const style = await blurStyle(src);
---

<Picture src={src} formats={["avif", "webp"]} alt={alt} sizes={sizes} widths={widths} class={className} style={style} aria-hidden={ariaHidden} pictureAttributes={{ style: "display: contents" }} />
