---
import "./run-line.scss";

// A title whose words swap for another of their own readings, one word at a
// time and strictly in turn. Served showing each word's first reading, which
// is also what stays under reduced motion; run-line.ts does the swapping.
---

<span class="nsc-run-line"><slot /></span>

<script>
  // Every .nsc-run-line on the page, from one timer each (run-line.ts).
  import { runLines } from "./run-line";

  runLines();
</script>
