---
import { getProjects } from "@/lib/projects";

// A project's name inside a sentence of the band's copy, opening exactly what
// its frame opens. A button, not an anchor: it is a pane sliding over the
// page, not a navigation to a URL of its own. .inline-link is the shared
// style — see globals.
//
// Falls back to plain text when no entry carries that slug, so a project can
// be dropped (or set to draft) without this going looking for it.
//
// `data-open` is the showcase controller's; `data-card` is the cursor card's.
interface Props {
  slug: string;
}

const { slug } = Astro.props;

// What a project's name in the copy promises, on the card at the pointer. Just
// the label: the sentence around the name is already the description.
const LINK_LABEL = "view details";
const exists = (await getProjects()).some((entry) => entry.id === slug);
---

{exists ? <button type="button" class="inline-link" data-open={slug} data-card={LINK_LABEL}><slot /></button> : <slot />}
