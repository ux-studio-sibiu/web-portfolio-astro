---
// The fold: exactly one viewport tall, so the projects below it are only
// reachable by scrolling. Content sits in column 3 with its own header, so the
// left half stays the identity.
//
// Layout (the `band` class, the column grid, `--col-media`) comes from the
// showcase shell; this file only owns what is inside the band. The numbered
// rows are the shared `.spec-*` device in globals.scss, also used by Skills.
---

<section class="band is-fold nsc-band-core-technologies">
  <div class="band-content">
    <ul class="spec-list">
      <li class="spec-row">
        <h2 class="spec-name">HTML, CSS, JS, TypeScript</h2>
        <p class="spec-note">proficient with the fundamentals, Core Web Vitals optimization, performance profiling </p>
      </li>

      <li class="spec-row">
        <h2 class="spec-name">Next.js, React</h2>
        <p class="spec-note">SSR, SSG, App Router, component libraries, caching and revalidation</p>
      </li>

      <li class="spec-row">
        <h2 class="spec-name">Data Visualization</h2>
        <p class="spec-note">d3.js, three.js, map-libre, webgl</p>
      </li>

      <li class="spec-row">
        <h2 class="spec-name">GSAP, Motion, Lenis</h2>
        <p class="spec-note">scroll-driven motion, vector animation, micro-interactions</p>
      </li>

      <li class="spec-row">
        <h2 class="spec-name">C# .NET, MVC</h2>
        <p class="spec-note">jquery, ajax spa libraries, kendoUI, signalR</p>
      </li>

      <li class="spec-row">
        <h2 class="spec-name">Headless CMS</h2>
        <p class="spec-note">Sanity, structured content, webhook-driven caching</p>
      </li>

      <li class="spec-row">
        <h2 class="spec-name">AI Development</h2>
        <p class="spec-note">claude code, github copilot, chatGPT - balance strengths/limitations</p>
      </li>

      {/* <li class="spec-row">
        <h2 class="spec-name">Workflow Tools</h2>
        <p class="spec-note">figma, github, vscode, vercel, photoshop </p>
      </li> */}

      <li class="spec-row">
        <h2 class="spec-name">Github, Figma</h2>
        <p class="spec-note">and other workflow tools: VScode, vercel, photoshop</p>
      </li>

      {/* <li class="spec-row">
        <h2 class="spec-name">Legacy</h2>
        <p class="spec-note">.net, mvc, jquery, ajax spa libraries, kendoUI, signalR </p>
      </li> */}
    </ul>
  </div>
</section>
