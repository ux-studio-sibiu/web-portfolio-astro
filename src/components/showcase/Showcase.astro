---
import { HOME_TITLE, type Project } from "@/lib/projects";
import FixedColumn from "@/components/fixed-column/FixedColumn.astro";
import ElasticLine from "@/components/elastic-line/ElasticLine.astro";
import DetailPane from "@/components/detail-pane/DetailPane.astro";
import SectionRail from "@/components/section-rail/SectionRail.astro";
import SideMenu from "@/components/side-menu/SideMenu.astro";
import CursorCard from "@/components/cursor-card/CursorCard.astro";
import "./showcase.scss";

// The shell. It owns the frame and nothing else: the two-pane track, the three
// columns of the index pane, the divider between columns 2 and 3, and the two
// things fixed over all of it — the section rail and the side menu.
//
// The bands are its children, written in Home.astro in page order. Each band
// is its own component and brings its own stylesheet. A band that wants the
// rail's title declares `data-section="Label"` on itself.
//
// Behaviour lives in <nsc-showcase> (showcase-controller.ts), a custom element
// wrapped around the markup. It is `display: contents`, so it adds no box of
// its own and the layout is exactly what it was without it.
//
// `projects` is every entry that can be opened, for the detail pane. `open`,
// on a /work/<slug>/ page, is the one that is open on arrival: the track, the
// panes' `inert`, the rail and its button are all served in their open state,
// the state the controller's render() would put them in, so it finds nothing
// to change. `data-open` tells it which project that is, and the two titles
// are what it sets document.title back and forth between.
interface Props {
  projects: Project[];
  open?: Project;
}

const { projects, open } = Astro.props;
---

<nsc-showcase data-open={open?.id} data-home-title={HOME_TITLE}>
  <div class="nsc-showcase-linear">
    <div class:list={["showcase-track", { "is-detail": open }]}>

      {/* Index pane — three vertical sections. Column 1 is fixed and never scrolls; columns 2 and 3 scroll together inside .pane-scroll. The rule between 2 and 3 is the same line the project thumbnails sit against: both are placed off --col-media, so they cannot drift. */}
      <section class="showcase-pane index-pane" inert={open ? true : undefined}>
        <FixedColumn />

        {/* Columns 2 + 3 — scrolling. */}
        <div class="pane-scroll">
          <div class="scroll-inner">
            <slot />
          </div>
        </div>

        {/* The divider. It sits on the pane rather than in the scrolling content, so it reads as one full-height line that ends on the bottom edge of the screen. */}
        <ElasticLine class="column-rule" />
      </section>

      <DetailPane projects={projects} open={open} />

    </div>

    {/* Outside the track, fixed to the viewport: the rail and the one control on the page stay exactly where they are while the detail pane comes over the top of everything else. */}
    <SectionRail project={open && { title: open.data.railTitle ?? open.data.title, box: open.data.railTitleBox }} />
  </div>

  {/* Outside the shell entirely, where Next needed a portal to put it. */}
  <SideMenu reveal="fade" />

  {/* The card at the pointer: its stylesheet and script, once for the page. */}
  <CursorCard />
</nsc-showcase>

<script>
  import "./showcase-controller";
</script>
