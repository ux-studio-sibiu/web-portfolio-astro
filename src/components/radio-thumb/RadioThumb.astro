---
import "./radio-thumb.scss";

// The archive's television, assembled from the prototype's own two files
// instead of booting the page that draws one.
//
// Plain <img> from public/, not <Image>: an optimiser takes an animated gif
// and hands back a still of its first frame.
---

<span class="nsc-radio-thumb">
  <img class="screen" src="/radio/static.gif" alt="" aria-hidden="true" />
  <img class="set" src="/radio/tv.png" alt="" aria-hidden="true" />
</span>
